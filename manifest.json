{
  "manifest_version": 3,
  "name": "M3U Stream",
  "version": "1.0.0",
  "icons": {
    "16": "Icon.png",
    "48": "Icon.png",
    "128": "Icon.png"
  },
  "description": "Scans the active page for M3U links and highlights them green (valid) or red (invalid / timeout).",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "M3U Link Validator"
  }
}
